# Clerk authentication (https://dashboard.clerk.com -> API Keys)
# Get keys via: npx clerk@latest env pull   (or: npx clerk@latest init)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Neon Postgres database (https://console.neon.tech -> your project)
# Connection string format: DATABASE_URL=postgres://user:password@host.neon.tech/db
DATABASE_URL=postgres://user:password@host.neon.tech/db

# Public base URL of the app (http://localhost:3000 in development)
NEXT_PUBLIC_APP_URL=http://localhost:3000